  "SettingDefinitions": [
    {
      "Type": "textbox",
      "Value": {
        "Key": "cacheTtlSeconds",
        "Label": "Refresh interval (seconds)",
        "DefaultValue": "180",
        "Tooltip": "Refresh the cached usage snapshot in the background at this interval.",
        "MaxLines": 1,
        "Validators": [
          {
            "Type": "is_number",
            "Value": {
              "IsInteger": true,
              "IsFloat": false
            }
          }
        ],
        "Style": {
          "Width": 240
        }
      }
    }
